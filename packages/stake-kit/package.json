{
  "name": "@energy8platform/stake-kit",
  "version": "0.4.4",
  "type": "module",
  "main": "dist/stake-kit.umd.js",
  "module": "dist/stake-kit.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/stake-kit.esm.js",
      "require": "./dist/stake-kit.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./harness": {
      "import": "./dist/harness.esm.js",
      "types": "./dist/harness.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@energy8platform/game-sdk": "^2.9.0",
    "@energy8platform/stake-bridge": ">=0.2.1",
    "@energy8platform/platform-core": "*",
    "@energy8platform/harness": "*",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "@energy8platform/harness": {
      "optional": true
    }
  },
  "devDependencies": {
    "@energy8platform/game-sdk": "^2.7.2",
    "@energy8platform/stake-bridge": "*",
    "@energy8platform/platform-core": "*",
    "@energy8platform/harness": "*",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^22.0.0",
    "rollup": "^4.24.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0"
  }
}
