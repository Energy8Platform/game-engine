{
  "name": "@energy8platform/game-engine",
  "version": "0.32.3",
  "description": "Universal casino game engine built on PixiJS v8 and @energy8platform/game-sdk",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.esm.js",
      "require": "./dist/core.cjs.js",
      "types": "./dist/core.d.ts"
    },
    "./assets": {
      "import": "./dist/assets.esm.js",
      "require": "./dist/assets.cjs.js",
      "types": "./dist/assets.d.ts"
    },
    "./audio": {
      "import": "./dist/audio.esm.js",
      "require": "./dist/audio.cjs.js",
      "types": "./dist/audio.d.ts"
    },
    "./animation": {
      "import": "./dist/animation.esm.js",
      "require": "./dist/animation.cjs.js",
      "types": "./dist/animation.d.ts"
    },
    "./debug": {
      "import": "./dist/debug.esm.js",
      "require": "./dist/debug.cjs.js",
      "types": "./dist/debug.d.ts"
    },
    "./shell": {
      "import": "./dist/shell.esm.js",
      "require": "./dist/shell.cjs.js",
      "types": "./dist/shell.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.esm.js",
      "require": "./dist/vite.cjs.js",
      "types": "./dist/vite.d.ts"
    },
    "./lua": {
      "import": "./dist/lua.esm.js",
      "require": "./dist/lua.cjs.js",
      "types": "./dist/lua.d.ts"
    },
    "./game-spec": {
      "import": "./dist/game-spec.esm.js",
      "require": "./dist/game-spec.cjs.js",
      "types": "./dist/game-spec.d.ts"
    },
    "./host": {
      "import": "./dist/host.esm.js",
      "require": "./dist/host.cjs.js",
      "types": "./dist/host.d.ts"
    },
    "./slot": {
      "import": "./dist/slot.esm.js",
      "require": "./dist/slot.cjs.js",
      "types": "./dist/slot.d.ts"
    },
    "./devtools": {
      "import": "./dist/devtools.esm.js",
      "require": "./dist/devtools.cjs.js",
      "types": "./dist/devtools.d.ts"
    },
    "./harness": {
      "import": "./dist/harness.esm.js",
      "require": "./dist/harness.cjs.js",
      "types": "./dist/harness.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs -w",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@energy8platform/platform-core": ">=0.30.1",
    "@energy8platform/shell": ">=0.5.0"
  },
  "peerDependencies": {
    "@energy8platform/game-sdk": "^2.9.0",
    "@energy8platform/stake-bridge": ">=0.2.1",
    "@energy8platform/harness": "*",
    "pixi.js": "^8.16.0"
  },
  "peerDependenciesMeta": {
    "@energy8platform/harness": {
      "optional": true
    },
    "@energy8platform/stake-bridge": {
      "optional": true
    },
    "@esotericsoftware/spine-pixi-v8": {
      "optional": true
    },
    "@pixi/sound": {
      "optional": true
    }
  },
  "devDependencies": {
    "@energy8platform/game-sdk": "^2.8.0",
    "@energy8platform/harness": "*",
    "@energy8platform/stake-bridge": "*",
    "@esotericsoftware/spine-pixi-v8": "~4.2.0",
    "@pixi/sound": "^6.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "pixi.js": "^8.16.0",
    "prettier": "^3.4.0",
    "rollup": "^4.24.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "casino",
    "game-engine",
    "pixijs",
    "slot",
    "igaming"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/energy8platform/game-engine.git"
  }
}
