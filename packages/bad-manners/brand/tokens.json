{
  "$schema": "bad-manners/tokens@1",
  "color": {
    "ink":        "#0B0B0B",
    "void":       "#000000",
    "paper":      "#FFFFFF",
    "lime":       "#B6FF3B",
    "limeHover":  "#C8FF6A",
    "limePress":  "#8FD61F",
    "grey700":    "#2B2B2B",
    "grey600":    "#3A3A3A",
    "grey500":    "#6B6B6B",
    "grey400":    "#8A8A8A",
    "scrim":      "rgba(0,0,0,0.55)"
  },
  "role": {
    "plaque":           "ink",
    "plaqueDisabled":   "grey700",
    "glyph":            "paper",
    "glyphActive":      "lime",
    "glyphDisabled":    "grey500",
    "glyphOnLime":      "ink",
    "label":            "lime",
    "value":            "paper",
    "caption":          "grey400",
    "primary":          "lime",
    "primaryText":      "ink",
    "outline":          "lime",
    "progressTrack":    "grey600",
    "progressFill":     "lime",
    "volatilityOn":     "lime",
    "volatilityOff":    "grey700"
  },
  "font": {
    "display": { "family": "Luckiest Guy", "weight": 400, "case": "upper", "letterSpacing": 0.03, "use": "titles, button labels, field labels (BALANCE / WIN / BET), tabs" },
    "numeric": { "family": "Montserrat", "weight": 800, "use": "money, multipliers, counters, RTP" },
    "body":    { "family": "Montserrat", "weight": 600, "use": "descriptions, rules text" },
    "displayFallbackNonLatin": { "family": "Montserrat", "weight": 900, "case": "upper", "note": "Luckiest Guy has Latin only; use for ru/uk/ja/zh/ko/ar etc." }
  },
  "type": {
    "title":       { "font": "display", "size": 44 },
    "tab":         { "font": "display", "size": 30 },
    "button":      { "font": "display", "size": 30 },
    "fieldLabel":  { "font": "display", "size": 24, "color": "label" },
    "fieldValue":  { "font": "numeric", "size": 28, "color": "value" },
    "price":       { "font": "numeric", "size": 52 },
    "cardTitle":   { "font": "display", "size": 44 },
    "body":        { "font": "body",    "size": 22, "lineHeight": 1.45, "color": "paper" },
    "caption":     { "font": "body",    "size": 16, "color": "caption" },
    "tableMult":   { "font": "numeric", "size": 18, "color": "lime" },
    "tableCount":  { "font": "body",    "size": 18, "color": "grey400" }
  },
  "space": { "xs": 6, "s": 12, "m": 18, "l": 28, "xl": 40, "safe": 40 },
  "radius": { "plaque": 12, "pill": 24, "card": 6, "track": 8, "underline": 4 },
  "stroke": { "outline": 3 },
  "size": {
    "iconGlyph": 64,
    "hudButton": 76,
    "hudField": { "h": 76, "minW": 220 },
    "spin": 128,
    "pillButton": { "h": 64, "minW": 240 },
    "sliderTrackH": 16,
    "sliderKnob": 62,
    "close": { "w": 88, "h": 84 }
  },
  "motion": {
    "press":   { "scale": 0.94, "dur": 80,  "ease": "power2.out" },
    "release": { "scale": 1.0,  "dur": 180, "ease": "back.out(3)" },
    "hover":   { "dur": 120, "ease": "power1.out" },
    "panelIn": { "dur": 220, "ease": "back.out(1.6)", "from": { "scale": 0.92, "alpha": 0 } },
    "panelOut":{ "dur": 140, "ease": "power2.in",     "to":   { "scale": 0.96, "alpha": 0 } },
    "scrimIn": { "dur": 180, "ease": "none" },
    "menuIn":  { "dur": 240, "ease": "power3.out", "from": { "x": -1 } },
    "bubblePop": { "dur": 260, "ease": "back.out(2.2)", "pivot": "tail tip", "from": { "scale": 0 } },
    "spinGlyph": { "rpsIdle": 0, "rpsSpinning": 2.2, "rpsTurbo": 4 },
    "winCount":  { "ease": "power1.out", "minDur": 400, "maxDur": 2500 }
  },
  "blur": { "panelBackdrop": 12 }
}
