# Native simulation binaries (downloaded by postinstall or built from Go)
bin/simulate-*
bin/e8-*
bin/simulation-*
packages/*/bin/simulate-*
packages/*/bin/e8-*
packages/*/bin/simulation-*

# Brainstorming visual companion
.superpowers/

# Local brainstorm / scratch notes
idea.md
/examples/demo-slot
/.claude

# npm registry auth (contains a private-registry token — never commit)
.npmrc

# Playwright run artifacts
/engine/apps/web/test-results/
/engine/apps/web/playwright-report/

# Projects created by the IDE (and the Playwright copies) live beside the
# shipped examples; only the three shipped ones are tracked.
/engine/examples/*
!/engine/examples/first-slot/
!/engine/examples/probe-plugin/
!/engine/examples/workspace/
